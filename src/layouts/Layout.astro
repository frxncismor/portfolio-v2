---
import '../styles/global.css'
import tokensCss from '../styles/tokens.css?raw'

interface Props {
  title?: string
  description?: string
  ogImage?: string
  keywords?: string
}

const {
  title       = 'Francisco Moreno — Software Engineer',
  description = 'Full-stack software engineer based in Houston, TX. 6 years building production systems for Disney, Royal Caribbean, United Airlines & more. Angular frontends and .NET/Node.js APIs, with experience in Express, Supabase, Firebase, PostgreSQL, and Docker infrastructure.',
  ogImage     = '/og-image.svg',
  keywords    = 'Software Engineer, Angular developer, TypeScript, React, Next.js, Astro, Node.js, .NET, C#, ASP.NET Core, PostgreSQL, Fastify, Express, Firebase, Docker, Full-stack Engineer, Frontend Engineer, Houston TX, freelance developer, JavaScript, Angular specialist, Datadog, Sentry',
} = Astro.props

const fontsHref =
  'https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,400,100,1&family=Geist:wght@400;500&family=Geist+Mono:wght@400;500&display=swap'

// <meta theme-color> needs literal colors: read --paper (dark first, light second) from tokens.css.
const [paperDark = '', paperLight = ''] = [...tokensCss.matchAll(/--paper:\s*(#[0-9a-f]{3,8})/gi)].map((m) => m[1])

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const ogImageURL   = new URL(ogImage, Astro.site)

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Francisco Moreno',
  url: 'https://frxncismor.dev',
  jobTitle: 'Full-Stack Software Engineer',
  description: 'Full-stack software engineer based in Houston, TX. 6 years building production systems for Disney, Royal Caribbean, United Airlines & more.',
  knowsAbout: ['Angular', 'TypeScript', 'React', 'Next.js', 'Astro', 'JavaScript', 'Node.js', 'Express', 'Supabase', 'Firebase', 'Docker', 'SQL Server', 'MySQL', 'Frontend Architecture', 'Backend Development', 'DevOps', 'Datadog', 'Sentry'],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Houston',
    addressRegion: 'TX',
    addressCountry: 'US',
  },
  sameAs: [
    'https://github.com/frxncismor',
    'https://linkedin.com/in/frxncismor',
  ],
}

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Francisco Moreno',
  url: 'https://frxncismor.dev',
  description: 'Portfolio of Francisco Moreno — Software Engineer based in Houston, TX.',
  author: { '@type': 'Person', name: 'Francisco Moreno', url: 'https://frxncismor.dev' },
  publisher: { '@type': 'Person', name: 'Francisco Moreno', url: 'https://frxncismor.dev' },
}
---

<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />

    <!--
      Theme + language init: runs before the stylesheets and the first paint.
      - Theme: applies the saved choice (fm-theme) as data-theme; without one, CSS follows prefers-color-scheme.
      - Language: applies the saved lang so .lang-en / .lang-es blocks switch with no flash.
    -->
    <script is:inline>
      ;(function () {
        var root = document.documentElement
        try {
          var theme = localStorage.getItem("fm-theme")
          if (theme === "light" || theme === "dark") root.setAttribute("data-theme", theme)
        } catch (e) {}
        try {
          var lang = localStorage.getItem("lang")
          if (lang === "es" || lang === "en") {
            root.setAttribute("data-lang", lang)
            root.setAttribute("lang", lang)
          }
        } catch (e) {}
      })()
    </script>

    <!-- Fonts: Fraunces (display), Geist (text), Geist Mono (labels/code). Non-render-blocking. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={fontsHref} />
    <link rel="stylesheet" media="print" onload="this.media='all'" href={fontsHref} />
    <noscript>
      <link rel="stylesheet" href={fontsHref} />
    </noscript>

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description"  content={description} />
    <meta name="keywords"     content={keywords} />
    <meta name="author"       content="Francisco Moreno" />
    <meta name="publisher"    content="Francisco Moreno" />
    <link rel="canonical"     href={canonicalURL} />
    <meta name="robots"       content="index, follow" />
    <meta name="generator"    content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImageURL} />
    <meta property="og:site_name"   content="frxncismor.dev" />
    <meta property="og:locale"      content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:site"        content="@frxncismor" />
    <meta name="twitter:creator"     content="@frxncismor" />
    <meta name="twitter:url"         content={canonicalURL} />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImageURL} />

    <!-- JSON-LD Person + WebSite schemas -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <link rel="icon" type="image/svg+xml" href="/brand/avatar-dark.svg" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/brand/avatar-light.svg" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={paperDark} media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content={paperLight} media="(prefers-color-scheme: light)" />
  </head>
  <body>
    <a href="#main-content" class="skip-link" data-i18n="nav.skip">Skip to content</a>
    <slot />
  </body>
</html>
