---
import '../styles/global.css'
import tokensCss from '../styles/tokens.css?raw'
import { t, type Lang } from '../i18n/translations'
import { basePath, localePath, ogLocale, withSlash } from '../i18n/routes'
import { social } from '../data/site'
import { safeJson } from '../lib/json'

interface Props {
  /** Page language, fixed by the route (`/es/...` is Spanish). */
  lang: Lang
  /** Defaults to the home title / description of `lang`. */
  title?: string
  description?: string
  ogImage?: string
  keywords?: string
  /** Open Graph type: `article` for blog posts (adds article:published_time). */
  ogType?: 'website' | 'article'
  /** ISO date, only used when ogType is `article`. */
  publishedTime?: string
  /** Keeps utility pages (404) out of search results. */
  noindex?: boolean
}

const {
  lang,
  title       = t(lang, 'meta.title'),
  description = t(lang, 'meta.desc'),
  ogImage     = '/og-image.png',
  ogType      = 'website',
  publishedTime,
  noindex     = false,
  keywords    = 'Software Engineer, Angular developer, TypeScript, React, Next.js, Astro, Node.js, .NET, C#, ASP.NET Core, PostgreSQL, Fastify, Express, Firebase, Docker, Full-stack Engineer, Frontend Engineer, Houston TX, freelance developer, JavaScript, Angular specialist, Datadog, Sentry',
} = Astro.props

const fontsHref =
  'https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,400,100,1&family=Geist:wght@400;500&family=Geist+Mono:wght@400;500&display=swap'

// <meta theme-color> needs literal colors: read --paper (dark first, light second) from tokens.css.
const [paperDark = '', paperLight = ''] = [...tokensCss.matchAll(/--paper:\s*(#[0-9a-f]{3,8})/gi)].map((m) => m[1])

const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const ogImageURL   = new URL(ogImage, Astro.site)
const ogImageAlt   = t(lang, 'meta.og-alt')
const otherLang: Lang = lang === 'en' ? 'es' : 'en'

// Every indexable page exists in both languages at the same path (Spanish under /es/): hreflang pairs them.
const enPath = withSlash(basePath(Astro.url.pathname))
const alternates = noindex
  ? []
  : [
      { hreflang: 'en', href: new URL(enPath, Astro.site) },
      { hreflang: 'es', href: new URL(localePath('es', enPath), Astro.site) },
      { hreflang: 'x-default', href: new URL(enPath, Astro.site) },
    ]

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Francisco Moreno',
  url: 'https://frxncismor.dev',
  jobTitle: 'Full-Stack Software Engineer',
  description: 'Full-stack software engineer based in Houston, TX. 6 years building production systems for Disney, Royal Caribbean, United Airlines & more, from Angular frontends to .NET and Node.js backends.',
  knowsAbout: ['Angular', 'TypeScript', 'React', 'Next.js', 'Astro', 'JavaScript', '.NET', 'C#', 'ASP.NET Core', 'Node.js', 'Fastify', 'Express', 'PostgreSQL', 'Drizzle ORM', 'Supabase', 'Firebase', 'Docker', 'REST APIs', 'Frontend Architecture', 'Backend Development', 'Automated Testing', 'AI-assisted Development', 'Datadog', 'Sentry'],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Houston',
    addressRegion: 'TX',
    addressCountry: 'US',
  },
  sameAs: social.map((s) => s.href),
}

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Francisco Moreno',
  url: 'https://frxncismor.dev',
  description: t(lang, 'meta.desc'),
  inLanguage: lang,
  author: { '@type': 'Person', name: 'Francisco Moreno', url: 'https://frxncismor.dev' },
  publisher: { '@type': 'Person', name: 'Francisco Moreno', url: 'https://frxncismor.dev' },
}
---

<!doctype html>
<html lang={lang} data-lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />

    <!--
      Theme init: runs before the stylesheets and the first paint. Applies the saved choice (fm-theme)
      as data-theme; without one, CSS follows prefers-color-scheme. The language comes from the route.
    -->
    <script is:inline define:vars={{ paperDark, paperLight }}>
      ;(function () {
        var root = document.documentElement
        try {
          var theme = localStorage.getItem("fm-theme")
          if (theme === "light" || theme === "dark") {
            root.setAttribute("data-theme", theme)
            // Metas/icons are parsed after this script: sync theme-color and favicon with the saved theme.
            document.addEventListener("DOMContentLoaded", function () {
              document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) {
                m.removeAttribute("media")
                m.setAttribute("content", theme === "light" ? paperLight : paperDark)
              })
              document.querySelectorAll('link[rel="icon"]').forEach(function (l) {
                var isLight = l.getAttribute("href").indexOf("avatar-light") !== -1
                l.media = (theme === "light") === isLight ? "all" : "not all"
              })
            })
          }
        } catch (e) {}
      })()
    </script>

    <!-- Fonts: Fraunces (display), Geist (text), Geist Mono (labels/code). Non-render-blocking. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={fontsHref} />
    <link rel="stylesheet" media="print" onload="this.media='all'" href={fontsHref} />
    <noscript>
      <link rel="stylesheet" href={fontsHref} />
    </noscript>

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description"  content={description} />
    <meta name="keywords"     content={keywords} />
    <meta name="author"       content="Francisco Moreno" />
    <meta name="publisher"    content="Francisco Moreno" />
    <link rel="canonical"     href={canonicalURL} />
    <meta name="robots"       content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="generator"    content={Astro.generator} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    <!-- Open Graph -->
    <meta property="og:type"        content={ogType} />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImageURL} />
    <meta property="og:image:type"   content="image/png" />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt"    content={ogImageAlt} />
    <meta property="og:site_name"   content="frxncismor.dev" />
    <meta property="og:locale"      content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[otherLang]} />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && <meta property="article:author" content="Francisco Moreno" />}

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:site"        content="@frxncismor" />
    <meta name="twitter:creator"     content="@frxncismor" />
    <meta name="twitter:url"         content={canonicalURL} />
    <meta name="twitter:title"       content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImageURL} />
    <meta name="twitter:image:alt"   content={ogImageAlt} />

    <!-- JSON-LD Person + WebSite schemas -->
    <script type="application/ld+json" set:html={safeJson(personSchema)} />
    <script type="application/ld+json" set:html={safeJson(websiteSchema)} />

    <link rel="icon" type="image/svg+xml" href="/brand/avatar-dark.svg" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/brand/avatar-light.svg" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={paperDark} media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content={paperLight} media="(prefers-color-scheme: light)" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{t(lang, 'nav.skip')}</a>
    <slot />
  </body>
</html>
