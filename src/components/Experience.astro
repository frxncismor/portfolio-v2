---
import { experience, freelance } from '../data/experience'
---

<section id="experience" class="section-block">
  <div class="wrap">
    <div class="section-head reveal">
      <div>
        <p class="label" data-i18n="exp.label">Experience</p>
        <h2 class="serif" data-i18n="exp.title">Where I've worked</h2>
      </div>
    </div>

    <div class="rows">
      {experience.map((item) => (
        <div class="exp reveal">
          <p class="label">
            <span class="lang-en">{item.period.en}</span>
            <span class="lang-es">{item.period.es}</span>
          </p>
          <div class="exp-body">
            <h3>
              {item.company}
              <span>
                — <span class="lang-en">{item.role.en}</span><span class="lang-es">{item.role.es}</span>
              </span>
            </h3>
            <p>
              <span class="lang-en">{item.description.en}</span>
              <span class="lang-es">{item.description.es}</span>
            </p>
            <p class="clients-line">{item.clients}</p>
          </div>
        </div>
      ))}
    </div>

    <p class="label sub reveal" data-i18n="exp.freelance">Freelance &amp; independent</p>

    <div class="rows">
      {freelance.map((item) => (
        <div class="exp reveal">
          <p class="label" data-i18n="exp.client">Client</p>
          <div class="exp-body">
            <h3>
              {item.name}
              <span>
                — <span class="lang-en">{item.tagline.en}</span><span class="lang-es">{item.tagline.es}</span>
              </span>
            </h3>
            <p>
              <span class="lang-en">{item.description.en}</span>
              <span class="lang-es">{item.description.es}</span>
            </p>
          </div>
          {item.url && item.openLabel && (
            <a class="ext" href={item.url} target="_blank" rel="noopener noreferrer">
              <span class="sr-only">
                <span class="lang-en">{item.openLabel.en}</span>
                <span class="lang-es">{item.openLabel.es}</span>
              </span>
              <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
                <path d="M4 10 10 4M5 4h5v5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .rows .exp:last-child { border-bottom: 1px solid var(--hairline); }
  .exp {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr) auto;
    gap: 8px 32px;
    padding-block: 28px;
    border-top: 1px solid var(--hairline);
  }
  .exp .label { padding-top: 7px; }
  .exp-body { min-width: 0; }
  .exp h3 {
    margin: 0;
    font: 500 19px/28px var(--sans);
    color: var(--ink);
  }
  .exp h3 > span { color: var(--muted); font-weight: 400; }
  .exp p { margin: 6px 0 0; color: var(--muted); font-size: 15px; line-height: 24px; max-width: 38em; }
  .exp .label { margin: 0; }
  .exp .clients-line { color: var(--ink); }
  .exp a.ext {
    align-self: start;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    margin-top: 2px;
    border-radius: var(--r-sm);
    color: var(--muted);
    transition: color .15s, transform .15s cubic-bezier(.2, .7, .2, 1);
  }
  .exp a.ext:hover { color: var(--accent); transform: translate(2px, -2px); }
  .exp a.ext:focus-visible { outline: none; box-shadow: var(--focus); color: var(--accent); }
  .sub { margin: 56px 0 16px; }

  @media (max-width: 640px) {
    .exp { grid-template-columns: minmax(0, 1fr) auto; }
    .exp .label { grid-column: 1 / -1; padding-top: 0; }
  }
</style>
