---
import { aboutFacts, aboutParagraphs, aboutQuote } from '../data/about'
import { t, type Lang } from '../i18n/translations'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
---

<section id="about" class="section-block">
  <div class="wrap about">
    <div class="reveal">
      <p class="label">{t(lang, 'about.label')}</p>
      <blockquote class="serif">
        {aboutQuote.pre[lang]}<em>{aboutQuote.em[lang]}</em>{aboutQuote.post[lang]}
      </blockquote>
    </div>

    <div class="text reveal">
      {aboutParagraphs.map((p) => (
        <p>
          {p[lang]}
        </p>
      ))}
      <ul class="facts">
        {aboutFacts.map((fact) => (
          <li>
            <b>{fact.value}</b>
            <span>
              {fact.label[lang]}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 64px;
  }
  blockquote {
    margin: 16px 0 0;
    font-size: clamp(28px, 3.6vw, 40px);
    line-height: 1.15;
    letter-spacing: -.01em;
    font-variation-settings: "SOFT" 100, "WONK" 1, "opsz" 72;
  }
  blockquote em { color: var(--accent); font-style: normal; }
  .text { display: grid; gap: 18px; color: var(--muted); }
  .text p { margin: 0; }
  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin: 12px 0 0;
    padding: 24px 0 0;
    list-style: none;
    border-top: 1px solid var(--hairline);
  }
  .facts b {
    display: block;
    font-family: var(--display);
    font-weight: 400;
    font-size: 40px;
    line-height: 1;
    color: var(--ink);
    font-variation-settings: "SOFT" 100, "WONK" 1, "opsz" 72;
    font-variant-numeric: tabular-nums;
  }
  .facts span { font-size: 13px; line-height: 20px; }

  @media (max-width: 900px) {
    .about { grid-template-columns: 1fr; gap: 32px; }
  }
  @media (max-width: 640px) {
    .facts { gap: 12px; }
    .facts b { font-size: 30px; }
  }
</style>
