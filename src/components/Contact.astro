---
const year = new Date().getFullYear()
import { email, social } from '../data/site'

const socials = [
  ...social.map((s) => ({ href: s.href, key: `contact.${s.id}`, label: s.label, external: true })),
  { href: '/blog', key: 'contact.blog', label: 'Blog', external: false },
]
---

<section id="contact" class="contact">
  <div class="wrap inner">
    <p class="label reveal" data-i18n="contact.label">Contact</p>
    <h2 class="serif reveal" data-i18n="contact.title">Let's build something good.</h2>
    <p class="lead reveal" data-i18n="contact.lead">Open to full-time roles and selected freelance projects.</p>

    <div class="mail reveal">
      <code id="email">{email}</code>
      <button class="copy" type="button" id="copy-btn" data-i18n="contact.copy">Copy email</button>
      <span id="copy-status" class="sr-only" role="status" aria-live="polite"></span>
    </div>

    <div class="socials reveal">
      {socials.map((s) => (
        <a
          class="link"
          href={s.href}
          target={s.external ? '_blank' : undefined}
          rel={s.external ? 'noopener noreferrer' : undefined}
        >
          <span data-i18n={s.key}>{s.label}</span>
          <svg class="arrow" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
            <path d="M4 10 10 4M5 4h5v5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      ))}
    </div>

    <div class="foot">
      <p class="label">© {year} Francisco Moreno</p>
      <p class="label" data-i18n="contact.foot">Houston, TX · Built with care</p>
    </div>
  </div>
</section>

<script>
  import '../scripts/contact'
</script>

<style>
  .contact {
    margin-top: 128px;
    background: var(--sunken);
    border-top: 1px solid var(--hairline);
  }
  .inner { padding-block: 112px 48px; display: grid; gap: 28px; }
  h2 {
    margin: 0;
    font-size: clamp(48px, 8vw, 104px);
    line-height: .95;
    letter-spacing: -.025em;
    font-variation-settings: "SOFT" 100, "WONK" 1, "opsz" 144;
    text-wrap: balance;
  }
  .lead { margin: 0; color: var(--muted); max-width: 34em; }
  .mail { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; }
  code {
    font: 400 clamp(20px, 3vw, 30px)/1.2 var(--display);
    font-variation-settings: "SOFT" 100, "WONK" 1;
    color: var(--accent);
    user-select: all;
    word-break: break-all;
  }
  .copy {
    height: 36px;
    padding: 0 14px;
    border-radius: var(--r-md);
    border: 1px solid var(--hairline);
    background: none;
    color: var(--ink);
    font: 500 13px/1 var(--sans);
    cursor: pointer;
    transition: border-color .15s;
  }
  .copy:hover { border-color: var(--muted); }
  .socials { display: flex; flex-wrap: wrap; gap: 28px; }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin-top: 80px;
    padding-top: 24px;
    border-top: 1px solid var(--hairline);
  }

  @media (max-width: 640px) {
    .contact { margin-top: 96px; }
    .inner { padding-block: 80px 40px; }
    .foot { margin-top: 56px; }
  }
</style>
