---
import { projects } from '../data/projects'
import ProjectCard from './ProjectCard.astro'
import { t, type Lang } from '../i18n/translations'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
---

<section id="work" class="section-block">
  <div class="wrap">
    <div class="section-head reveal">
      <div>
        <p class="label">{t(lang, 'work.label')}</p>
        <h2 class="serif">{t(lang, 'work.title')}</h2>
      </div>
      <p class="note">{t(lang, 'work.note')}</p>
    </div>

    <div class="feed">
      {projects.map((project) => <ProjectCard project={project} lang={lang} />)}
    </div>
  </div>
</section>

<style>
  .feed {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px 32px;
  }
  /* Staggered feed: the right column sits 96px lower (ProjectCard is a child component, hence :global) */
  .feed > :global(.post:nth-child(even)) {
    margin-top: 96px;
  }
  @media (max-width: 640px) {
    .feed {
      grid-template-columns: 1fr;
    }
    .feed > :global(.post:nth-child(even)) {
      margin-top: 0;
    }
  }
</style>
