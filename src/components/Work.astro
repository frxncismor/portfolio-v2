---
import { projects } from '../data/projects'
import ProjectCard from './ProjectCard.astro'
---

<section id="work" class="section-block">
  <div class="wrap">
    <div class="section-head reveal">
      <div>
        <p class="label" data-i18n="work.label">Selected work</p>
        <h2 class="serif" data-i18n="work.title">Things I've built lately</h2>
      </div>
      <p class="note" data-i18n="work.note">
        Products and a few experiments. Each one taught me something about speed, motion or detail.
      </p>
    </div>

    <div class="feed">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
</section>

<style>
  .feed {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px 32px;
  }
  /* Staggered feed: the right column sits 96px lower (ProjectCard is a child component, hence :global) */
  .feed > :global(.post:nth-child(even)) {
    margin-top: 96px;
  }
  @media (max-width: 640px) {
    .feed {
      grid-template-columns: 1fr;
    }
    .feed > :global(.post:nth-child(even)) {
      margin-top: 0;
    }
  }
</style>
