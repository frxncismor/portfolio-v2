---
import Layout from '../../layouts/Layout.astro'
import Nav from '../Nav.astro'
import Footer from '../Footer.astro'
import Toc from '../blog/Toc.astro'
import { readingTime } from '../../lib/readingTime'
import type { Post } from '../../lib/posts'
import { safeJson } from '../../lib/json'
import { ogImagePath } from '../../lib/og'
import { t, type Lang } from '../../i18n/translations'
import { dateLocale, localePath } from '../../i18n/routes'

/** Article body, shared by `/blog/<slug>` (EN) and `/es/blog/<slug>` (ES): only `lang` is rendered. */
interface Props {
  post: Post
  lang: Lang
  /** Newer post. */
  next?: Post
  /** Older post. */
  prev?: Post
}

const { post, lang, next, prev } = Astro.props
const entry = lang === 'es' ? post.es : post.en
const { title, description, category, date } = entry.data

const { Content, headings: all } = await entry.render()
const headings = all.filter((h) => h.depth === 2).map(({ slug, text }) => ({ slug, text }))

// Dates come from `YYYY-MM-DD` front matter (UTC midnight): format in UTC to avoid off-by-one days.
const published = date.toLocaleDateString(dateLocale[lang], { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
const minutes = readingTime(entry.body)

const neighbors = [
  next && { post: next, label: t(lang, 'blog.next') },
  prev && { post: prev, label: t(lang, 'blog.prev') },
]
  .filter((n): n is { post: Post; label: string } => !!n)
  .map(({ post: n, label }) => ({
    href: localePath(lang, `/blog/${n.slug}`),
    title: lang === 'es' ? n.titleEs : n.titleEn,
    category: n.category,
    label,
  }))

const ogImage = ogImagePath(post.slug, lang)
const postUrl = new URL(localePath(lang, `/blog/${post.slug}/`), Astro.site).href
const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  inLanguage: lang,
  image: new URL(ogImage, Astro.site).href,
  url: postUrl,
  author: {
    '@type': 'Person',
    name: 'Francisco Moreno',
    url: 'https://frxncismor.dev',
  },
  publisher: {
    '@type': 'Person',
    name: 'Francisco Moreno',
    url: 'https://frxncismor.dev',
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
}
---

<Layout
  lang={lang}
  title={`${title} — Francisco Moreno`}
  description={description}
  ogType="article"
  ogImage={ogImage}
  ogImageAlt={title}
  publishedTime={date.toISOString()}
  keywords={`${category}, ${title}, Francisco Moreno, Angular, TypeScript, JavaScript, frontend development`}
>
  <script type="application/ld+json" set:html={safeJson(blogPostingSchema)} />
  <Nav lang={lang} />

  <main id="main-content">
    <div class="progress" aria-hidden="true"><i id="progress-bar"></i></div>

    <article class="wrap article">
      <header class="head">
        <a class="back label" href={localePath(lang, '/blog')}>{t(lang, 'blog.back')}</a>
        <div class="meta">
          <span class="topic">{category}</span>
          <span class="label">{published} · {minutes} {t(lang, 'blog.min-read')}</span>
        </div>
        <h1 class="serif">{title}</h1>
        <p class="dek">{description}</p>
      </header>

      <div class="grid">
        <Toc headings={headings} lang={lang} />

        <div class="body">
          <div class="prose"><Content /></div>

          {neighbors.length > 0 && (
            <footer class="foot">
              <p class="label">{t(lang, 'blog.keep-reading')}</p>
              <div class={`next ${neighbors.length === 1 ? 'single' : ''}`}>
                {neighbors.map((n) => (
                  <a href={n.href}>
                    <span class="label">{n.label} · {n.category}</span>
                    <span class="serif title">{n.title}</span>
                  </a>
                ))}
              </div>
            </footer>
          )}
        </div>
      </div>
    </article>
  </main>

  <Footer lang={lang} />
</Layout>

<style>
  .progress {
    position: sticky;
    top: 64px;
    z-index: 4;
    height: 2px;
  }
  .progress i {
    display: block;
    height: 100%;
    width: 0;
    background: var(--accent);
  }

  .head {
    display: grid;
    gap: 20px;
    justify-items: start;
    max-width: 860px;
    padding-block: 72px 48px;
  }
  .back { text-decoration: none; transition: color .15s; }
  .back:hover { color: var(--accent); }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; }
  h1 {
    margin: 8px 0 0;
    font-size: clamp(40px, 6.4vw, 80px);
    line-height: 1.02;
    letter-spacing: -.025em;
    text-wrap: balance;
    overflow-wrap: break-word;
    max-width: 100%;
    font-variation-settings: "SOFT" 100, "WONK" 1, "opsz" 144;
  }
  .dek { margin: 0; font-size: 21px; line-height: 32px; color: var(--muted); max-width: 32em; }

  .grid {
    display: grid;
    grid-template-columns: 200px minmax(0, 680px);
    gap: 72px;
    padding-top: 40px;
    border-top: 1px solid var(--hairline);
  }
  .body { min-width: 0; }

  .foot {
    display: grid;
    gap: 16px;
    margin-top: 72px;
    padding-top: 32px;
    border-top: 1px solid var(--hairline);
  }
  .next { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .next.single { grid-template-columns: minmax(0, 1fr); }
  .next a {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 22px;
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    text-decoration: none;
    transition: border-color .15s, transform .15s cubic-bezier(.2, .7, .2, 1);
  }
  .next a:hover { border-color: var(--accent); transform: translateY(-3px); }
  .next .title { font-size: 20px; line-height: 1.25; }

  @media (max-width: 900px) {
    .grid { grid-template-columns: minmax(0, 1fr); gap: 0; }
  }
  @media (max-width: 640px) {
    .head { padding-block: 48px 32px; }
    .dek { font-size: 19px; line-height: 29px; }
    .next { grid-template-columns: minmax(0, 1fr); }
  }
  @media (prefers-reduced-motion: reduce) {
    .next a:hover { transform: none; }
  }
</style>

<script>
  import '../../scripts/animations'
</script>
<script>
  import '../../scripts/article'
</script>
