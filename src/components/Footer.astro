---
import Logo from './Logo.astro'

const year = new Date().getFullYear()
---

<footer class="site-foot">
  <div class="wrap inner">
    <Logo />
    <nav class="socials" aria-label="Footer" data-i18n-aria="footer.nav-aria">
      <a class="link" href="https://github.com/frxncismor" target="_blank" rel="noopener noreferrer">
        <span data-i18n="footer.github">GitHub</span>
      </a>
      <a class="link" href="https://linkedin.com/in/frxncismor" target="_blank" rel="noopener noreferrer">
        <span data-i18n="footer.linkedin">LinkedIn</span>
      </a>
      <a class="link" href="/#contact">
        <span data-i18n="footer.contact">Contact</span>
      </a>
    </nav>
    <p class="label">© {year} Francisco Moreno · Houston, TX</p>
  </div>
</footer>

<style>
  .site-foot {
    margin-top: 128px;
    border-top: 1px solid var(--hairline);
    background: var(--sunken);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding-block: 40px;
  }
  .socials { display: flex; flex-wrap: wrap; gap: 8px 28px; }
</style>
