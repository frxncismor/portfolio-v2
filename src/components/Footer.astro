---
import Logo from './Logo.astro'
import { social } from '../data/site'
import { t, type Lang } from '../i18n/translations'
import { localePath } from '../i18n/routes'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const year = new Date().getFullYear()
---

<footer class="site-foot">
  <div class="wrap inner">
    <Logo lang={lang} />
    <nav class="socials" aria-label={t(lang, 'footer.nav-aria')}>
      {social.map((s) => (
        <a class="link" href={s.href} target="_blank" rel="noopener noreferrer">
          <span>{t(lang, `footer.${s.id}`)}</span>
        </a>
      ))}
      <a class="link" href={localePath(lang, '/#contact')}>
        <span>{t(lang, 'footer.contact')}</span>
      </a>
    </nav>
    <p class="label">© {year} Francisco Moreno · Houston, TX</p>
  </div>
</footer>

<style>
  .site-foot {
    margin-top: 128px;
    border-top: 1px solid var(--hairline);
    background: var(--sunken);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding-block: 40px;
  }
  .socials { display: flex; flex-wrap: wrap; gap: 8px 28px; }
</style>
