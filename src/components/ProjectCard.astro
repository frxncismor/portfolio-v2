---
import type { Project } from '../data/projects'
import ProjectCover from './ProjectCover.astro'

interface Props {
  project: Project
}

const { project } = Astro.props

// Cards without a website (Grim Builds) link to the source code on GitHub.
const href = project.url ?? project.githubUrl
const isGithubOnly = !project.url && Boolean(project.githubUrl)
const titleId = `project-${project.id}-title`
const hintId = `project-${project.id}-hint`
---

<a
  class="post reveal"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={isGithubOnly ? undefined : project.title}
  aria-labelledby={isGithubOnly ? `${titleId} ${hintId}` : undefined}
>
  <div class="shot">
    <span class="tag">
      <span class="lang-en">{project.category.en}</span>
      <span class="lang-es">{project.category.es}</span>
      {project.wip && <span class="wip"> · WIP</span>}
    </span>
    <ProjectCover id={project.id} />
  </div>

  <div class="meta">
    <h3 id={titleId}>{project.title}</h3>
    <span class="go">
      {isGithubOnly && <span class="gh" aria-hidden="true">GitHub</span>}
      <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false">
        <path d="M4 10 10 4M5 4h5v5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </span>
  </div>

  {isGithubOnly && (
    <span class="sr-only" id={hintId}>
      <span class="lang-en">source code on GitHub</span>
      <span class="lang-es">código fuente en GitHub</span>
    </span>
  )}

  <p class="desc">
    <span class="lang-en">{project.description.en}</span>
    <span class="lang-es">{project.description.es}</span>
  </p>
  <p class="label stack">{project.stack.join(' · ')}</p>
</a>

<style>
  .post {
    display: grid;
    gap: 18px;
    text-decoration: none;
    border-radius: var(--r-lg);
    align-content: start;
  }
  .shot {
    position: relative;
    aspect-ratio: 4 / 5;
    max-width: 100%;
    border-radius: var(--r-lg);
    overflow: hidden;
    border: 1px solid var(--hairline);
    transition: box-shadow .25s, transform .35s cubic-bezier(.2, .7, .2, 1);
  }
  .post:hover .shot,
  .post:focus-visible .shot {
    box-shadow: var(--shadow-sm);
    transform: translateY(-3px);
  }
  .tag {
    position: absolute;
    left: 14px;
    top: 14px;
    z-index: 2;
    padding: 6px 9px;
    border-radius: var(--r-sm);
    background: var(--art-tag-bg);
    color: var(--art-ink);
    font: 500 11px/1 var(--mono);
    letter-spacing: .06em;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }
  .meta h3 {
    margin: 0;
    font: 500 19px/26px var(--sans);
  }
  .go {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    flex: none;
    transition: color .15s;
  }
  .go svg {
    transition: transform .15s;
  }
  .gh {
    font: 500 12px/16px var(--mono);
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .post:hover .go,
  .post:focus-visible .go {
    color: var(--accent);
  }
  .post:hover .go svg,
  .post:focus-visible .go svg {
    transform: translate(2px, -2px);
  }
  .desc {
    margin: -10px 0 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 24px;
  }
  .stack {
    margin-top: -6px;
  }
</style>
