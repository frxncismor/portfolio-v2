---
import { templates } from '../data/templates'
import TemplateCard from './TemplateCard.astro'
---

<section id="templates" class="section-block">
  <div class="wrap">
    <div class="section-head reveal">
      <div>
        <p class="label" data-i18n="templates.label">Templates</p>
        <h2 class="serif" data-i18n="templates.title">Ready-made sites</h2>
      </div>
      <p class="note" data-i18n="templates.note">
        Production-ready HTML and CSS. No frameworks, no build tools. Buy once, own forever.
      </p>
    </div>

    {templates.map((template) => <TemplateCard template={template} />)}
  </div>
</section>
