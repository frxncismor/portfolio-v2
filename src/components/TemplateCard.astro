---
import type { Template } from '../data/templates'

interface Props {
  template: Template
}

const { template } = Astro.props
---

<article class="tpl reveal">
  <div class="art" aria-hidden="true">
    <span class="art-name">{template.name}</span>
  </div>
  <div class="body">
    <p class="label">
      <span class="lang-en">{template.tag.en}</span>
      <span class="lang-es">{template.tag.es}</span>
    </p>
    <h3>
      {template.name}
      <span class="price">${template.price}</span>
    </h3>
    <p class="desc">
      <span class="lang-en">{template.description.en}</span>
      <span class="lang-es">{template.description.es}</span>
    </p>
    <a class="link" href={template.url} target="_blank" rel="noopener noreferrer">
      <span data-i18n="templates.buy">Buy on Gumroad</span>
      <span class="sr-only">— {template.name}</span>
      <svg class="arrow" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
        <path d="M2 7h10M8 3l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </a>
  </div>
</article>

<style>
  .tpl {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    border: 1px solid var(--hairline);
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--surface);
  }
  .art {
    position: relative;
    overflow: hidden;
    min-height: 320px;
    background: var(--art-pine);
  }
  .art::before {
    content: "";
    position: absolute;
    left: -12%;
    bottom: -30%;
    width: 70%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--art-ember);
  }
  .art-name {
    position: absolute;
    left: 28px;
    top: 26px;
    font-family: var(--display);
    font-size: 40px;
    line-height: 1.1;
    color: var(--art-paper);
    font-variation-settings: "SOFT" 100, "WONK" 1, "opsz" 72;
  }
  .body {
    display: grid;
    gap: 16px;
    align-content: center;
    padding: 36px;
  }
  h3 {
    margin: 0;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    font: 500 22px/30px var(--sans);
  }
  .price { font: 500 16px/1 var(--mono); color: var(--clay); }
  .desc { margin: 0; color: var(--muted); font-size: 15px; line-height: 24px; }
  .link { width: fit-content; }

  @media (max-width: 900px) {
    .tpl { grid-template-columns: 1fr; }
    .art { min-height: 220px; }
  }
  @media (max-width: 640px) {
    .body { padding: 24px; }
  }
</style>
