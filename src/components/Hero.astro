---
import { t, type Lang } from '../i18n/translations'

// Headline is marked up per language (spans per word, accent marks) — see plan.md "i18n".
interface Props {
  lang: Lang
}

const { lang } = Astro.props
---

<section id="hero" class="hero">
  <div class="wrap inner">
    <div class="who">
      <p class="label name">Francisco Moreno</p>
      <span class="sep" aria-hidden="true"></span>
      <p class="label">{t(lang, 'hero.role')}</p>
    </div>

    <h1 class="serif">
      {lang === 'en' ? (
        <>
        <span class="w" style="animation-delay:0ms">I’ve</span>
        <span class="w" style="animation-delay:50ms">spent</span>
        <span class="w" style="animation-delay:100ms">six</span>
        <span class="w" style="animation-delay:150ms">years</span>
        <span class="w" style="animation-delay:200ms">building</span>
        <span class="w" style="animation-delay:250ms">software</span>
        <span class="w" style="animation-delay:300ms">for</span>
        <span class="w" style="animation-delay:350ms">brands</span>
        <span class="w br" style="animation-delay:400ms">you</span>
        <span class="w br" style="animation-delay:450ms">use</span>
        <span class="w br" style="animation-delay:500ms">every</span>
        <span class="nw"><span class="w br" style="animation-delay:550ms">day</span>.</span>
        </>
      ) : (
        <>
        <span class="w" style="animation-delay:0ms">Llevo</span>
        <span class="w" style="animation-delay:50ms">seis</span>
        <span class="w" style="animation-delay:100ms">años</span>
        <span class="w" style="animation-delay:150ms">construyendo</span>
        <span class="w" style="animation-delay:200ms">software</span>
        <span class="w" style="animation-delay:250ms">para</span>
        <span class="w" style="animation-delay:300ms">marcas</span>
        <span class="w br" style="animation-delay:350ms">que</span>
        <span class="w br" style="animation-delay:400ms">usas</span>
        <span class="w br" style="animation-delay:450ms">a</span>
        <span class="nw"><span class="w br" style="animation-delay:500ms">diario</span>.</span>
        </>
      )}
    </h1>

    <div class="actions">
      <a class="btn" href="#work">{t(lang, 'hero.cta-work')}</a>
      <a class="btn ghost" href="#experience">{t(lang, 'hero.cta-exp')}</a>
      <p class="label stack">{t(lang, 'hero.stack')}</p>
    </div>
  </div>
</section>

<style>
  .inner {
    display: grid;
    gap: 32px;
    justify-items: start;
    padding-block: 120px 96px;
  }
  .who {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
  }
  .who .name {
    color: var(--ink);
  }
  .sep {
    width: 24px;
    height: 1px;
    background: var(--hairline);
  }
  h1 {
    margin: 0;
    max-width: 15.5em;
    font-size: clamp(40px, 6.6vw, 84px);
    line-height: 1.04;
    letter-spacing: -0.022em;
    text-wrap: balance;
    font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144;
  }
  .br {
    color: var(--accent);
  }
  .nw {
    white-space: nowrap;
  }
  .w {
    display: inline-block;
    animation: rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes rise {
    from {
      opacity: 0.001;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .actions .stack {
    margin-left: 16px;
  }

  @media (max-width: 900px) {
    .inner {
      padding-block: 72px 64px;
      gap: 28px;
    }
    .sep {
      display: none;
    }
    .who {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
    .actions .stack {
      margin-left: 0;
      flex-basis: 100%;
      margin-top: 8px;
    }
  }
</style>
