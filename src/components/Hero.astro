---
// Headline is marked up per language (spans per word, accent marks) — see plan.md "i18n".
---

<section id="hero" class="hero">
  <div class="wrap inner">
    <div class="who">
      <p class="label name">Francisco Moreno</p>
      <span class="sep" aria-hidden="true"></span>
      <p class="label" data-i18n="hero.role">Full-Stack Software Engineer · Houston, TX</p>
    </div>

    <h1 class="serif">
      <span class="lang-en">
        <span class="w" style="animation-delay:0ms">I</span>
        <span class="w" style="animation-delay:50ms">build</span>
        <span class="w" style="animation-delay:100ms">software</span>
        <span class="w" style="animation-delay:150ms">for</span>
        <span class="nw"><span class="w br" style="animation-delay:200ms">Disney</span>,</span>
        <span class="nw"><span class="w br" style="animation-delay:250ms">Royal Caribbean</span>,</span>
        <span class="w br" style="animation-delay:300ms">United Airlines</span>
        <span class="w" style="animation-delay:350ms">and</span>
        <span class="nw"><span class="w br" style="animation-delay:400ms">OXXO</span>.</span>
      </span>
      <span class="lang-es">
        <span class="w" style="animation-delay:0ms">Construyo</span>
        <span class="w" style="animation-delay:50ms">software</span>
        <span class="w" style="animation-delay:100ms">para</span>
        <span class="nw"><span class="w br" style="animation-delay:150ms">Disney</span>,</span>
        <span class="nw"><span class="w br" style="animation-delay:200ms">Royal Caribbean</span>,</span>
        <span class="w br" style="animation-delay:250ms">United Airlines</span>
        <span class="w" style="animation-delay:300ms">y</span>
        <span class="nw"><span class="w br" style="animation-delay:350ms">OXXO</span>.</span>
      </span>
    </h1>

    <div class="actions">
      <a class="btn" href="#work" data-i18n="hero.cta-work">See my work</a>
      <a class="btn ghost" href="#experience" data-i18n="hero.cta-exp">View experience</a>
      <p class="label stack" data-i18n="hero.stack">Angular · .NET &amp; Node · AI-assisted, human-reviewed</p>
    </div>
  </div>
</section>

<style>
  .inner {
    display: grid;
    gap: 32px;
    justify-items: start;
    padding-block: 120px 96px;
  }
  .who {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
  }
  .who .name {
    color: var(--ink);
  }
  .sep {
    width: 24px;
    height: 1px;
    background: var(--hairline);
  }
  h1 {
    margin: 0;
    max-width: 15.5em;
    font-size: clamp(40px, 6.6vw, 84px);
    line-height: 1.04;
    letter-spacing: -0.022em;
    text-wrap: balance;
    font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144;
  }
  .br {
    color: var(--accent);
  }
  .nw {
    white-space: nowrap;
  }
  .w {
    display: inline-block;
    animation: rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes rise {
    from {
      opacity: 0.001;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .actions .stack {
    margin-left: 16px;
  }

  @media (max-width: 900px) {
    .inner {
      padding-block: 72px 64px;
      gap: 28px;
    }
    .sep {
      display: none;
    }
    .who {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
    .actions .stack {
      margin-left: 0;
      flex-basis: 100%;
      margin-top: 8px;
    }
  }
</style>
