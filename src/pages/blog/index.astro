---
import Layout from '../../layouts/Layout.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'
import FeaturedPost from '../../components/blog/FeaturedPost.astro'
import PostRow from '../../components/blog/PostRow.astro'
import { getPosts } from '../../lib/posts'
import { safeJson } from '../../lib/json'
import { translations } from '../../i18n/translations'

const posts = await getPosts()

const [featured, ...rest] = posts
const categories = [...new Set(posts.map((p) => p.category))]

const searchManifest = posts.map(({ slug, titleEn, titleEs, descEn, descEs, category }) => ({
  slug, titleEn, titleEs, descEn, descEs, category,
}))

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Francisco Moreno — Blog',
  url: 'https://frxncismor.dev/blog',
  description: translations.en['meta.blog-desc'],
  author: { '@type': 'Person', name: 'Francisco Moreno', url: 'https://frxncismor.dev' },
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.titleEn,
    description: p.descEn,
    datePublished: p.date.toISOString(),
    url: `https://frxncismor.dev/blog/${p.slug}`,
  })),
}
---

<Layout
  title={translations.en['meta.blog-title']}
  description={translations.en['meta.blog-desc']}
  titleEs={translations.es['meta.blog-title']}
  descriptionEs={translations.es['meta.blog-desc']}
  keywords="Angular blog, TypeScript tutorials, JavaScript fundamentals, frontend development, web development 2026, Angular signals, ESLint Prettier Angular"
>
  <script type="application/ld+json" set:html={safeJson(blogSchema)} />
  <Nav />

  <main id="main-content">
    <section class="blog-head">
      <div class="wrap head-inner">
        <p class="label reveal" data-i18n="blog.label">Blog</p>
        <h1 class="serif reveal" data-i18n="blog.title">Notes on Angular, backend and building with AI</h1>
        <p class="lead reveal" data-i18n="blog.lead">
          What I learn shipping software, written down so the next person spends less time on it.
        </p>

        <div class="filters reveal">
          <label class="search" for="blog-search">
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
              <circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
              <path d="m10.5 10.5 3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
            </svg>
            <input
              id="blog-search"
              type="search"
              placeholder="Search posts"
              autocomplete="off"
              aria-label="Search posts"
              data-i18n-placeholder="blog.search-placeholder"
              data-i18n-aria="blog.search-aria"
            />
          </label>

          <div class="seg" role="group" aria-label="Filter by topic" data-i18n-aria="blog.filter-aria">
            <button type="button" data-filter="all" aria-pressed="true" data-i18n="blog.all">All</button>
            {categories.map((cat) => (
              <button type="button" data-filter={cat} aria-pressed="false">{cat}</button>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="wrap listing">
      {featured && <FeaturedPost {...featured} />}

      <div class="posts">
        {rest.map((post) => <PostRow {...post} />)}
      </div>

      <p class="empty" id="blog-empty" role="status" hidden>
        <span data-i18n="blog.empty">No posts match that search. Try another word or pick</span>
        <button type="button" id="blog-reset" data-i18n="blog.empty-reset">All topics</button>.
      </p>
    </section>
  </main>

  <Footer />

  <!-- Inline search manifest -->
  <script id="blog-search-index" type="application/json" set:html={safeJson(searchManifest)} />
</Layout>

<script>
  import '../../scripts/animations'
</script>
<script>
  import '../../scripts/i18n'
</script>
<script>
  import '../../scripts/blog'
</script>

<style>
  .head-inner { display: grid; gap: 24px; padding-block: 104px 56px; }
  h1 {
    margin: 0;
    max-width: 14em;
    font-size: clamp(40px, 6vw, 76px);
    line-height: 1.03;
    letter-spacing: -.022em;
    text-wrap: balance;
    font-variation-settings: "SOFT" 100, "WONK" 1, "opsz" 144;
  }
  .lead { margin: 0; color: var(--muted); max-width: 34em; }

  .filters { display: flex; flex-wrap: wrap; gap: 12px 16px; align-items: center; margin-top: 16px; }
  .search {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 44px;
    padding: 0 14px;
    min-width: 0;
    flex: 0 1 300px;
    border: 1px solid var(--hairline);
    border-radius: var(--r-md);
    color: var(--muted);
    background: var(--surface);
    transition: border-color .15s;
  }
  .search:focus-within { border-color: var(--accent); box-shadow: var(--focus); }
  .search input {
    border: 0;
    outline: 0;
    box-shadow: none;
    background: none;
    color: var(--ink);
    font: 400 15px/1 var(--sans);
    width: 100%;
    min-width: 0;
  }
  .search input::placeholder { color: var(--muted); }

  .seg { display: flex; flex-wrap: wrap; gap: 6px; }
  .seg button {
    height: 36px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid var(--hairline);
    background: none;
    color: var(--muted);
    font: 500 13px/1 var(--sans);
    cursor: pointer;
    transition: color .15s, border-color .15s, background-color .15s;
  }
  .seg button:hover { color: var(--ink); border-color: var(--muted); }
  .seg button[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: var(--paper); }

  /* Without JS the filters can't work: show the full list only. */
  @media (scripting: none) {
    .filters { display: none; }
  }

  .posts { margin-top: 56px; border-bottom: 1px solid var(--hairline); }
  /* The closing rule belongs to the list, so it survives when the last row is filtered out. */
  .posts :global(.post-row:last-child) { border-bottom: 0; }
  .posts:not(:has(.post-row:not([hidden]))) { border-bottom: 0; margin-top: 0; }

  .empty { color: var(--muted); padding-block: 40px; margin: 0; }
  .empty button {
    border: 0;
    background: none;
    color: var(--accent);
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
    border-radius: var(--r-sm);
  }

  @media (max-width: 640px) {
    .head-inner { padding-block: 64px 40px; }
    .search { flex: 1 1 100%; }
  }
</style>
